{
  "manifest_version": 3,
  "name": "Pixiv Novel Translator",
  "version": "1.3.2",
  "description": "Translate Pixiv Japanese novels with AI — powered by ShizukuTranslate",
  "permissions": [
    "activeTab",
    "alarms",
    "cookies",
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://www.pixiv.net/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.pixiv.net/novel/*"],
      "js": ["version.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pixiv Novel Translator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
